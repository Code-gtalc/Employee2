	<queryString language="SQL">
		<![CDATA[SELECT *
FROM employees
	left join dept_emp ON 
	 employees.emp_no = dept_emp.emp_no 
	left join titles ON 
	 employees.emp_no = titles.emp_no 
GROUP BY employees.emp_no]]>
	</queryString>
